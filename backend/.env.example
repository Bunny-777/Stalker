# ==========================================
# LeetCode Stalker Backend Environment Configuration
# ==========================================

# Port the backend server will run on (Default: 5000)
PORT=5000

# Telegram Bot Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# Create a bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Default Telegram Chat ID to send notifications to (e.g., 6344734804)
# Get your Chat ID by messaging @userinfobot or sending /start to your bot
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here

# Interval in seconds between background LeetCode profile checks (Default: 60 seconds)
POLL_INTERVAL_SECONDS=60

# Path to the JSON file where target data and logs are persisted
DATA_FILE_PATH=./data/stalker_data.json

# Enable Telegram bot polling for incoming commands like /start, /register (true/false)
ENABLE_TELEGRAM_POLLING=true
